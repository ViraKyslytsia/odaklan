PORT=4000
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/odaklan?retryWrites=true&w=majority
JWT_SECRET=change_this_secret_key
# адрес сайта без слэша на конце, например https://virakyslytsia.github.io
CLIENT_ORIGIN=

# Письма через Brevo (HTTP API, работает на Render)
BREVO_API_KEY=
# адрес должен быть подтверждён в Brevo: Senders, domains & dedicated IPs -> Senders
MAIL_FROM=odaklan <you@example.com>

# Запасной вариант для локальной разработки (используется, только если BREVO_API_KEY пуст)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=